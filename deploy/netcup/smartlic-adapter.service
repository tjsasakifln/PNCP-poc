[Unit]
Description=SmartLic FastAPI presentation adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartlic
Group=smartlic
WorkingDirectory=/opt/smartlic/backend
EnvironmentFile=/etc/smartlic/smartlic.env
ExecStart=/opt/smartlic/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/smartlic /var/log/smartlic
MemoryMax=512M
CPUQuota=60%

[Install]
WantedBy=multi-user.target
