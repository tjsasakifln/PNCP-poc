# /etc/smartlic/smartlic.env — never commit the real file.

SMARTLIC_DOMAIN=smartlic.tech
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://smartlic.tech
BACKEND_URL=http://127.0.0.1:8000

# extra-cli consumer. Server-side only. Never expose to Next.js public env.
PUBLIC_READ_V1_DSN=
PUBLIC_READ_V1_MODE=off
PUBLIC_READ_KILL_SWITCH=false
PUBLIC_READ_POOL_LIMIT=4
PUBLIC_READ_MAX_CONCURRENCY=8
PUBLIC_READ_STATEMENT_TIMEOUT_MS=2000
PUBLIC_READ_LOCK_TIMEOUT_MS=500
PUBLIC_READ_QUERY_BUDGET_PER_MIN=120

SAAS_COMMERCE_ENABLED=false
LEAD_OUTBOX_PATH=/var/lib/smartlic/lead-outbox.jsonl

# Transitional stores — KEEP+ADAPT until cutover.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
OPENAI_API_KEY=
RESEND_API_KEY=
SENTRY_DSN=

# Deploy identity
SMARTLIC_DEPLOY_SHA=
SMARTLIC_CONFIG_HASH=
