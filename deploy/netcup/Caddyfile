# SmartLic public surface — Netcup reverse proxy / TLS
# Replace {$SMARTLIC_DOMAIN} and upstreams before first boot.

{$SMARTLIC_DOMAIN:smartlic.tech} {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /health/live {
		reverse_proxy 127.0.0.1:8000
	}

	handle /health/ready {
		reverse_proxy 127.0.0.1:8000
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /metrics {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output file /var/log/smartlic/caddy.access.log {
			roll_size 50MiB
			roll_keep 14
		}
	}
}
