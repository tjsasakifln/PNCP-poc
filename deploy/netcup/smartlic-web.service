[Unit]
Description=SmartLic Next.js public surface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartlic
Group=smartlic
WorkingDirectory=/opt/smartlic/frontend
EnvironmentFile=/etc/smartlic/smartlic.env
ExecStart=/usr/bin/node /opt/smartlic/frontend/node_modules/next/dist/bin/next start -p 3000
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/smartlic /var/log/smartlic
MemoryMax=768M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
