# Copy to /etc/smartlic-bridge/env (mode 0640, root:caddy).
# No private keys. ACME email is an account contact, not a secret.

# Public IPv4 of the host that will terminate TLS. Owner fills this in.
# Discovery on 2026-08-14/15 found no live Netcup/bridge A; Railway still owns apex/www.
BRIDGE_PUBLIC_IPV4=

# Let's Encrypt account contact used by Caddy. Required before first issuance.
SMARTLIC_ACME_EMAIL=

# Optional: override Caddy data dir (default /var/lib/caddy).
# XDG_DATA_HOME=
